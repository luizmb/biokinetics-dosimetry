        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 si è fermato a %@ su %@ %@ dopo %lld passi. Aumenta il budget di passi, oppure usa Birchall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 在 %@ / %@ %@ 处运行 %lld 步后停止。请提高步数预算，或改用 Birchall。"
          }
        }
      }
    },
