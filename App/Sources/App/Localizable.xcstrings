    "This app is a Swift translation and extension of the SSID project originally developed by Thiago Claro at IPEN‑CNEN/SP, São Paulo, Brazil.": {
      "comment": "L.Credits.ssidStatement",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a Swift translation and extension of the SSID project originally developed by Thiago Claro at IPEN‑CNEN/SP, São Paulo, Brazil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app é uma tradução para Swift e uma extensão do projeto SSID, desenvolvido originalmente por Thiago Claro no IPEN‑CNEN/SP, São Paulo, Brasil."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app es una traducción a Swift y una ampliación del proyecto SSID, desarrollado originalmente por Thiago Claro en el IPEN‑CNEN/SP, São Paulo, Brasil."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist eine Swift-Übersetzung und Erweiterung des SSID-Projekts, das Thiago Claro ursprünglich am IPEN‑CNEN/SP in São Paulo, Brasilien, entwickelt hat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja to przeniesienie do Swifta i rozszerzenie projektu SSID, opracowanego pierwotnie przez Thiago Claro w IPEN‑CNEN/SP w São Paulo w Brazylii."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est une traduction en Swift et une extension du projet SSID, développé à l’origine par Thiago Claro à l’IPEN‑CNEN/SP, São Paulo, Brésil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è una traduzione in Swift e un’estensione del progetto SSID, sviluppato originariamente da Thiago Claro presso l’IPEN‑CNEN/SP, San Paolo, Brasile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用是 SSID 项目的 Swift 移植与扩展版本，该项目最初由 Thiago Claro 在巴西圣保罗的 IPEN‑CNEN/SP 开发。"
          }
        }
      }
    },
