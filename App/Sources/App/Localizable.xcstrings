    "Intake fractions sum to %@, which exceeds 1.0 — you cannot receive more activity than was administered. Reduce individual fractions.": {
      "comment": "L.Issues.intakeFractionExceedsOne",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Intake fractions sum to %@, which exceeds 1.0 — you cannot receive more activity than was administered. Reduce individual fractions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As frações de incorporação somam %@, mais que 1,0 — não é possível receber mais atividade do que a administrada. Reduza as frações."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fracciones de incorporación suman %@, más de 1,0: no se puede recibir más actividad de la administrada. Reduce las fracciones."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahmeanteile ergeben zusammen %@ und damit mehr als 1,0 — es kann nicht mehr Aktivität aufgenommen werden als verabreicht. Verringere einzelne Anteile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułamki wniknięcia sumują się do %@, czyli ponad 1,0 — nie można przyjąć więcej aktywności, niż podano. Zmniejsz poszczególne ułamki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme des fractions d’incorporation vaut %@, soit plus de 1,0 — on ne peut pas recevoir plus d’activité que celle administrée. Réduisez les fractions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frazioni di introduzione sommano a %@, più di 1,0: non si può ricevere più attività di quella somministrata. Riduci le singole frazioni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄入比例之和为 %@，超过 1.0 — 接收的活度不能多于给药量。请减小各个比例。"
          }
        }
      }
    },
