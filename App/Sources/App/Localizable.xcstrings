    "Three-pool lead toxicokinetic model (blood / bone / soft tissue) validated with stable isotope tracers.": {
      "comment": "L.Credits.rabinowitzDetail",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-pool lead toxicokinetic model (blood / bone / soft tissue) validated with stable isotope tracers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo toxicocinético do chumbo em três compartimentos (sangue / osso / tecido mole), validado com traçadores de isótopos estáveis."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo toxicocinético del plomo de tres compartimentos (sangre / hueso / tejido blando), validado con trazadores de isótopos estables."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Toxikokinetisches Bleimodell mit drei Pools (Blut / Knochen / Weichgewebe), validiert mit stabilen Isotopen als Tracer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzyprzedziałowy model toksykokinetyczny ołowiu (krew / kości / tkanki miękkie) zweryfikowany znacznikami izotopów stabilnych."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle toxicocinétique du plomb à trois compartiments (sang / os / tissus mous) validé avec des traceurs isotopiques stables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello tossicocinetico del piombo a tre compartimenti (sangue / osso / tessuti molli) validato con traccianti di isotopi stabili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铅的三池毒代动力学模型（血液 / 骨骼 / 软组织），经稳定同位素示踪剂验证。"
          }
        }
      }
    },
