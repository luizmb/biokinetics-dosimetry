    "No intake compartment — enable the Intake flag on the compartment that receives the administered activity.": {
      "comment": "L.Issues.noIntake",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No intake compartment — enable the Intake flag on the compartment that receives the administered activity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum compartimento de incorporação — ative a marcação Incorporação no compartimento que recebe a atividade administrada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún compartimento de incorporación: activa el indicador Incorporación en el compartimento que recibe la actividad administrada."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Aufnahmekompartiment — aktiviere „Aufnahme“ bei dem Kompartiment, das die verabreichte Aktivität erhält."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kompartmentu wniknięcia — włącz oznaczenie Wniknięcie w kompartmencie, który przyjmuje podaną aktywność."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compartiment d’incorporation — activez l’indicateur Incorporation sur le compartiment qui reçoit l’activité administrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun compartimento di introduzione — attiva l’indicatore Introduzione sul compartimento che riceve l’attività somministrata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有摄入房室 — 请在接收给药活度的房室上启用“摄入”标记。"
          }
        }
      }
    },
    "No tracked compartments — enable Track on at least one compartment to see results in the chart.": {
      "comment": "L.Issues.noTracked",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
