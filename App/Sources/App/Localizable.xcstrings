    "Matrix-exponential algorithm for compartmental radionuclide models. Implemented here as the Birchall solver.": {
      "comment": "L.Credits.birchallDetail",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix-exponential algorithm for compartmental radionuclide models. Implemented here as the Birchall solver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algoritmo de exponencial de matriz para modelos compartimentais de radionuclídeos. Implementado aqui como o solucionador Birchall."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Algoritmo de exponencial de matriz para modelos compartimentales de radionúclidos. Implementado aquí como el método Birchall."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrixexponential-Algorithmus für Kompartimentmodelle von Radionukliden. Hier als Birchall-Löser umgesetzt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Algorytm wykładnika macierzy dla kompartmentowych modeli radionuklidów. Zaimplementowany tu jako metoda Birchalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algorithme d’exponentielle de matrice pour les modèles compartimentaux de radionucléides. Implémenté ici comme le solveur Birchall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Algoritmo dell’esponenziale di matrice per modelli compartimentali di radionuclidi. Implementato qui come risolutore Birchall."
          }
        },
        "zh-Hans": {
