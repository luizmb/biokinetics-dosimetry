        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 zatrzymała się na %@ z %@ %@ po %lld krokach. Zwiększ budżet kroków albo użyj metody Birchalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 s’est arrêté à %@ sur %@ %@ après %lld pas. Augmentez le budget de pas, ou utilisez Birchall."
