    "RK45 stopped at %@ of %@ %@ after %lld steps. Raise the step budget, or use Birchall.": {
      "comment": "L.Calc.budgetExhausted",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 stopped at %@ of %@ %@ after %lld steps. Raise the step budget, or use Birchall."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RK45 parou em %@ de %@ %@ após %lld passos. Aumente o orçamento de passos, ou use o Birchall."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "RK45 se detuvo en %@ de %@ %@ tras %lld pasos. Aumenta el presupuesto de pasos, o usa Birchall."
