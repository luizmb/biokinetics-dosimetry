          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum compartimento acompanhado — ative Acompanhar em pelo menos um compartimento para ver resultados no gráfico."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún compartimento seguido: activa Seguir en al menos un compartimento para ver resultados en el gráfico."
          }
        },
        "de-DE": {
