    "%@ Original Smart Software for Internal Dosimetry — this app is a Swift rewrite of that work.": {
      "comment": "L.Credits.claroDetail",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Original Smart Software for Internal Dosimetry — this app is a Swift rewrite of that work."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O Smart Software for Internal Dosimetry original — este app é uma reescrita desse trabalho em Swift."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ El Smart Software for Internal Dosimetry original — esta app es una reescritura de ese trabajo en Swift."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die ursprüngliche Smart Software for Internal Dosimetry — diese App schreibt sie in Swift neu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Oryginalne Smart Software for Internal Dosimetry — ta aplikacja to przepisanie tej pracy w Swifcie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Le Smart Software for Internal Dosimetry d’origine — cette app en est une réécriture en Swift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Lo Smart Software for Internal Dosimetry originale — questa app ne è una riscrittura in Swift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原始的 Smart Software for Internal Dosimetry — 本应用是该成果的 Swift 重写版。"
          }
        }
      }
    },
