          "stringUnit": {
            "state": "translated",
            "value": "RK45 could not take a step at %@ %@. Use Birchall for this model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RK45 não conseguiu avançar em %@ %@. Use o Birchall para este modelo."
