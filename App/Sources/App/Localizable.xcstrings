    "Minimal two-compartment model. Substance enters A, distributes bidirectionally into B, and is slowly eliminated via Sink. A starting point for any field.": {
      "comment": "Sample model text",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal two-compartment model. Substance enters A, distributes bidirectionally into B, and is slowly eliminated via Sink. A starting point for any field."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo mínimo de dois compartimentos. A substância entra em A, distribui-se nos dois sentidos para B e é eliminada lentamente pelo sumidouro. Um ponto de partida para qualquer área."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo mínimo de dos compartimentos. La sustancia entra en A, se distribuye en ambos sentidos hacia B y se elimina lentamente por el sumidero. Un punto de partida para cualquier campo."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimales Zwei-Kompartiment-Modell. Die Substanz gelangt in A, verteilt sich in beide Richtungen nach B und wird langsam über die Senke eliminiert. Ein Ausgangspunkt für jedes Fachgebiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimalny model dwukompartmentowy. Substancja trafia do A, przemieszcza się w obu kierunkach do B i jest powoli eliminowana przez ujście. Punkt wyjścia dla każdej dziedziny."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle minimal à deux compartiments. La substance entre dans A, se distribue dans les deux sens vers B et est lentement éliminée par le puits. Un point de départ pour n’importe quel domaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello minimo a due compartimenti. La sostanza entra in A, si distribuisce in entrambe le direzioni verso B e viene eliminata lentamente attraverso il pozzo. Un punto di partenza per qualsiasi ambito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最简二房室模型。物质进入 A，在 A 与 B 之间双向分布，并经汇缓慢消除。适用于任何领域的起点。"
          }
        }
      }
    },
