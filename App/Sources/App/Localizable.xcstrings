    "Brings back the sample models you deleted. Samples you edited stay as they are.": {
      "comment": "L.Home.restoreSamplesHint",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings back the sample models you deleted. Samples you edited stay as they are."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz de volta os modelos de exemplo que você apagou. Os que você editou ficam como estão."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera los modelos de ejemplo que eliminaste. Los que editaste se quedan como están."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt gelöschte Beispielmodelle zurück. Bearbeitete Beispiele bleiben, wie sie sind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca usunięte przykładowe modele. Edytowane przykłady pozostają bez zmian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les modèles d’exemple que vous avez supprimés. Ceux que vous avez modifiés restent tels quels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina i modelli di esempio che hai eliminato. Quelli che hai modificato restano come sono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复你删除的示例模型。你编辑过的示例保持不变。"
          }
        }
      }
    },
