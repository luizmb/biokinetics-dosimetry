          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundamentos de programação funcional: composição de Result e Reader, óticas (lentes, prismas), transformadores de mônadas e as macros @Lenses / @Prisms."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundamentos de programación funcional: composición de Result y Reader, ópticas (lentes, prismas), transformadores de mónadas y las macros @Lenses / @Prisms."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
