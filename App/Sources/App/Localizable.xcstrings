    "Lazy tasks and publishers on Swift concurrency: how each calculation runs off the main thread.": {
      "comment": "L.Credits.reactiveDetail",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lazy tasks and publishers on Swift concurrency: how each calculation runs off the main thread."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarefas e publishers preguiçosos sobre a concorrência do Swift: como cada cálculo roda fora da thread principal."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tareas y publishers perezosos sobre la concurrencia de Swift: cómo cada cálculo se ejecuta fuera del hilo principal."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerte Tasks und Publisher auf Basis von Swift Concurrency: So läuft jede Berechnung abseits des Hauptthreads."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leniwe zadania i publishery na współbieżności Swifta: dzięki nim każde obliczenie działa poza wątkiem głównym."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâches et publishers paresseux sur la concurrence Swift : chaque calcul s’exécute hors du fil principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Task e publisher pigri sulla concorrenza di Swift: ogni calcolo gira fuori dal thread principale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 Swift 并发的惰性任务与 publisher：让每次计算都在主线程之外运行。"
          }
        }
      }
    },
