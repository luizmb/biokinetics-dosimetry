    "An RK4 step of %@ %@ is unstable for this model. Use a step below %@ %@, or Birchall.": {
      "comment": "L.Calc.unstableStep",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An RK4 step of %@ %@ is unstable for this model. Use a step below %@ %@, or Birchall."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passo de RK4 de %@ %@ é instável para este modelo. Use um passo abaixo de %@ %@, ou o Birchall."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso de RK4 de %@ %@ es inestable para este modelo. Usa un paso inferior a %@ %@, o Birchall."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein RK4-Schritt von %@ %@ ist für dieses Modell instabil. Verwende einen Schritt unter %@ %@ oder Birchall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krok RK4 równy %@ %@ jest dla tego modelu niestabilny. Użyj kroku poniżej %@ %@ albo metody Birchalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas RK4 de %@ %@ est instable pour ce modèle. Utilisez un pas inférieur à %@ %@, ou Birchall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passo RK4 di %@ %@ è instabile per questo modello. Usa un passo inferiore a %@ %@, oppure Birchall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对此模型，%@ %@ 的 RK4 步长不稳定。请使用小于 %@ %@ 的步长，或改用 Birchall。"
          }
        }
      }
    },
    "Aquatic food-chain bioaccumulation of a persistent pollutant. Substance enters the water column and biomagnifies through algae → invertebrates → fish, with slow elimination at the apex.": {
      "comment": "Sample model text",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquatic food-chain bioaccumulation of a persistent pollutant. Substance enters the water column and biomagnifies through algae → invertebrates → fish, with slow elimination at the apex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioacumulação de um poluente persistente numa cadeia alimentar aquática. A substância entra na coluna d’água e se biomagnifica através de algas → invertebrados → peixes, com eliminação lenta no topo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioacumulación de un contaminante persistente en una cadena trófica acuática. La sustancia entra en la columna de agua y se biomagnifica a través de algas → invertebrados → peces, con eliminación lenta en el vértice."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioakkumulation eines persistenten Schadstoffs in einer aquatischen Nahrungskette. Die Substanz gelangt in die Wassersäule und reichert sich über Algen → Wirbellose → Fische an, mit langsamer Elimination an der Spitze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioakumulacja trwałego zanieczyszczenia w wodnym łańcuchu pokarmowym. Substancja trafia do toni wodnej i ulega biomagnifikacji przez glony → bezkręgowce → ryby, z powolną eliminacją na szczycie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioaccumulation d’un polluant persistant dans une chaîne alimentaire aquatique. La substance entre dans la colonne d’eau et se bioamplifie via algues → invertébrés → poissons, avec une élimination lente au sommet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bioaccumulo di un inquinante persistente in una catena alimentare acquatica. La sostanza entra nella colonna d’acqua e si biomagnifica attraverso alghe → invertebrati → pesci, con eliminazione lenta al vertice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持久性污染物在水生食物链中的生物累积。物质进入水体，并经藻类 → 无脊椎动物 → 鱼类逐级生物放大，在顶端缓慢消除。"
          }
        }
      }
    },
